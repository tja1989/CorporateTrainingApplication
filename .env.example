# Database (required)
DATABASE_URL=postgres://lulu:lulu@127.0.0.1:5432/lulu_learn

# Session signing secret (required; any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# AI (optional — AI surfaces degrade to clear "unavailable" states without them)
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
VOYAGE_API_KEY=

# YouTube Data API key (optional — used to validate embeddability at ingest)
YOUTUBE_API_KEY=

# Hosted transcript vendor (optional; manual SRT/VTT upload always works)
TRANSCRIPT_PROVIDER=manual
SUPADATA_API_KEY=

# Email (optional — absent means the email channel is off; in-app inbox always delivers)
SMTP_URL=

# Demo mode: seeds fictional Demo Retail Co. data and enables demo banners
DEMO_MODE=true

# Voice (optional — Gemini Live powers the oral check and the HR assistant's live mode;
# without it both screens run in a typed offline demo mode with the same tools)
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE=Kore
# Language the spoken sessions are conducted in (BCP-47). Pins the transcriber:
# left to auto-detect, accented English is regularly transcribed into another language.
# GEMINI_LIVE_LANGUAGE=en-US
